    "docx": "^9.6.1",
    "electron-conf": "^1.3.0",
    "hyphen": "^1.14.1",
    "hypher": "^0.2.5",
    "i18next": "^26.0.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.8.0",
    "parchment-design": "github:AISCGre-BR/parchment-design#v1.0.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.4",
