    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "41.1.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.2",
    "jszip": "^3.10.1",
    "playwright": "1.63.0",
    "typescript": "~5.9.0",
    "vite": "7.3.2",
    "vitest": "^4.1.2"
